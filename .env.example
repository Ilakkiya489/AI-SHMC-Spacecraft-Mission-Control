# AI-SHMC Environment Configuration Example

# Server Host & Ports
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Database Configuration
DATABASE_URL=sqlite:///./data/ai_shmc.db

# Simulation & Telemetry Parameters
DEFAULT_SIM_SPEED=1.0
TELEMETRY_SAMPLING_RATE_HZ=1.0
